---
import Base from '../../layouts/Base.astro';
import Komentar from '../../components/Komentar.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const semuaCerita = await getCollection('cerita');
  return semuaCerita.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'cerita'>;
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const tanggalFormatted = entry.data.tanggal
  ? new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(entry.data.tanggal)
  : null;

const guestName = entry.data.tamu ?? entry.data.narasumberNama;

function toEmbedUrl(url: string | undefined): string | null {
  if (!url) return null;
  const short = url.match(/youtu\.be\/([\w-]+)/);
  const long  = url.match(/[?&]v=([\w-]+)/);
  const id = short?.[1] ?? long?.[1];
  return id ? `https://www.youtube.com/embed/${id}` : null;
}

function toMateriEmbedUrl(url: string | undefined): string | null {
  if (!url) return null;
  const slides = url.match(/docs\.google\.com\/presentation\/d\/([\w-]+)/);
  if (slides) return `https://docs.google.com/presentation/d/${slides[1]}/embed?start=false&loop=false&delayms=3000`;
  const drive = url.match(/drive\.google\.com\/file\/d\/([\w-]+)/);
  if (drive) return `https://drive.google.com/file/d/${drive[1]}/preview`;
  return null;
}

const embedUrl    = toEmbedUrl(entry.data.youtubeUrl);
const materiEmbed = toMateriEmbedUrl(entry.data.materiUrl);
---
<Base title={entry.data.title} description={entry.data.ringkasan}>
  <article class="story">
    <a class="back-link" href="/#cerita">&larr; Semua cerita</a>
    <p class="story-origin">{entry.data.kota ? `${entry.data.kota}, ` : ''}{entry.data.negara}{tanggalFormatted ? ` · ${tanggalFormatted}` : ''}</p>
    <h1>{entry.data.title}</h1>
    <p class="story-meta">
      {guestName && <span>Bersama {guestName}</span>}
      {entry.data.durasi && <span>· {entry.data.durasi}</span>}
    </p>

    {entry.data.audioUrl && (
      <div class="audio-wrap">
        <audio controls src={entry.data.audioUrl}></audio>
      </div>
    )}

    {embedUrl && (
      <div class="video-wrapper">
        <iframe
          src={embedUrl}
          title={`Rekaman ${entry.data.title}`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    )}

    {entry.data.tags.length > 0 && (
      <ul class="tags">
        {entry.data.tags.map((tag) => <li>#{tag}</li>)}
      </ul>
    )}

    <div class="story-body">
      <Content />
    </div>

    {materiEmbed && (
      <section class="materi">
        <h2>Materi Presentasi</h2>
        <div class="materi-wrapper">
          <iframe
            src={materiEmbed}
            title={`Materi ${entry.data.title}`}
            loading="lazy"
            allowfullscreen
          ></iframe>
        </div>
        {entry.data.materiUrl && (
          <p class="materi-link">
            <a href={entry.data.materiUrl} target="_blank" rel="noopener">Buka materi di tab baru &rarr;</a>
          </p>
        )}
      </section>
    )}

    {entry.data.youtubeUrl && !embedUrl && (
      <p><a href={entry.data.youtubeUrl} target="_blank" rel="noopener">Tonton rekaman di YouTube &rarr;</a></p>
    )}
  </article>

  <Komentar slug={entry.slug} />
</Base>

<style>
  .story {
    max-width: 42rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1.25rem, 4vw, 2.5rem) 2rem;
  }
  .back-link {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--ink-muted);
    text-decoration: none;
    margin-bottom: 2rem;
  }
  .back-link:hover { color: var(--accent-amber); }
  .story-origin {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-teal);
    margin: 0 0 0.75rem;
  }
  .story h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 5vw, 2.7rem);
    line-height: 1.15;
    margin: 0 0 0.75rem;
  }
  .story-meta {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin: 0 0 1.75rem;
  }
  .story-meta span + span { margin-left: 0.5rem; }
  .audio-wrap { margin-bottom: 1.75rem; }
  .audio-wrap audio { width: 100%; }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
    margin: 0 0 2rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent-teal);
  }
  .story-body {
    font-size: 1.05rem;
    color: var(--ink-soft);
  }
  .story-body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.4rem;
    margin-top: 2rem;
  }
  .story-body :global(a) { color: var(--accent-amber); }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    margin: 1.5rem 0;
    border-radius: 0.5rem;
  }
  .video-wrapper iframe {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    border: 0;
  }

  .materi {
    margin: 2rem 0 1rem;
  }
  .materi h2 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    margin: 0 0 1rem;
  }
  .materi-wrapper {
    width: 100%;
    height: 480px;
    overflow: hidden;
    border-radius: 0.5rem;
  }
  .materi-wrapper iframe {
    width: 100%; height: 100%;
    border: 1px solid var(--color-line, #dedad2);
  }
  .materi-link {
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }
  .materi-link a { color: var(--accent-amber); }
</style>
